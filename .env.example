# Copy to .env and fill in. Read only by the dev server, never sent to the browser.
OPENROUTER_API_KEY=sk-or-...
# Hard cap on OpenRouter spend per dev-server run (USD).
OPENROUTER_MAX_SPEND_USD=2

# Default multiplayer relay baked into the build (e.g. wss://grid-relay.onrender.com).
# VITE_GRID_SERVER=
